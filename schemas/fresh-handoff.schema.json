{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nazeyatta:schema:fresh-handoff:0.1",
  "title": "NazeYatta Fresh Worker Handoff",
  "description": "Single-bounce handoff compiled only from a KY Gate PASS. It does not grant execution authority.",
  "type": "object",
  "required": [
    "schema_version",
    "handoff_id",
    "classification",
    "task_id",
    "intended_action",
    "admitted_actions",
    "forbidden_actions",
    "required_hazard_ids",
    "required_control_ids",
    "required_stop_condition_ids",
    "source_refs",
    "bindings",
    "validity",
    "authority_granted"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "handoff_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "classification": {
      "const": "KY_VALIDATED_HANDOFF"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "intended_action": {
      "$ref": "#/$defs/actionAtom"
    },
    "admitted_actions": {
      "$ref": "#/$defs/nonEmptyActionAtoms"
    },
    "forbidden_actions": {
      "$ref": "#/$defs/actionAtoms"
    },
    "required_hazard_ids": {
      "$ref": "#/$defs/tokens"
    },
    "required_control_ids": {
      "$ref": "#/$defs/tokens"
    },
    "required_stop_condition_ids": {
      "$ref": "#/$defs/tokens"
    },
    "source_refs": {
      "type": "object",
      "required": ["authority_ref", "policy_ref", "evidence_refs"],
      "properties": {
        "authority_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "policy_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "additionalProperties": false
    },
    "bindings": {
      "type": "object",
      "required": [
        "declaration_id",
        "baseline_id",
        "declaration_fingerprint",
        "baseline_fingerprint",
        "gate_result_fingerprint"
      ],
      "properties": {
        "declaration_id": {
          "type": "string"
        },
        "baseline_id": {
          "type": "string"
        },
        "declaration_fingerprint": {
          "type": "string"
        },
        "baseline_fingerprint": {
          "type": "string"
        },
        "gate_result_fingerprint": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "validity": {
      "type": "object",
      "required": ["mode", "runtime_state_bound"],
      "properties": {
        "mode": {
          "const": "single_bounce"
        },
        "runtime_state_bound": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "authority_granted": {
      "const": false
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:/-]{0,127}$"
    },
    "tokens": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/token"
      }
    },
    "actionAtom": {
      "type": "object",
      "required": ["operation", "target"],
      "properties": {
        "operation": {
          "$ref": "#/$defs/token"
        },
        "target": {
          "$ref": "#/$defs/token"
        }
      },
      "additionalProperties": false
    },
    "actionAtoms": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/actionAtom"
      }
    },
    "nonEmptyActionAtoms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/actionAtom"
      }
    }
  },
  "additionalProperties": false
}
