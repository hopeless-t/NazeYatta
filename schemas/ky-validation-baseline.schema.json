{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nazeyatta:schema:ky-validation-baseline:0.1",
  "title": "NazeYatta KY Validation Baseline",
  "description": "Normalized comparison input prepared independently from authority, policy and evidence. Presence of source references does not authenticate those sources.",
  "type": "object",
  "required": [
    "schema_version",
    "baseline_id",
    "task_id",
    "classification",
    "allowed_actions",
    "forbidden_actions",
    "required_hazard_ids",
    "required_control_ids",
    "required_stop_condition_ids",
    "source_refs",
    "prepared_by",
    "prepared_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "baseline_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "classification": {
      "const": "NORMALIZED_VALIDATION_BASELINE"
    },
    "allowed_actions": {
      "$ref": "#/$defs/nonEmptyActionAtoms"
    },
    "forbidden_actions": {
      "$ref": "#/$defs/actionAtoms"
    },
    "required_hazard_ids": {
      "$ref": "#/$defs/tokens"
    },
    "required_control_ids": {
      "$ref": "#/$defs/tokens"
    },
    "required_stop_condition_ids": {
      "$ref": "#/$defs/tokens"
    },
    "source_refs": {
      "type": "object",
      "required": ["authority_ref", "policy_ref", "evidence_refs"],
      "properties": {
        "authority_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "policy_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "additionalProperties": false
    },
    "prepared_by": {
      "type": "object",
      "required": ["type", "identifier"],
      "properties": {
        "type": {
          "enum": ["human", "adapter", "workflow"]
        },
        "identifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "additionalProperties": false
    },
    "prepared_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:/-]{0,127}$"
    },
    "tokens": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/token"
      }
    },
    "actionAtom": {
      "type": "object",
      "required": ["operation", "target"],
      "properties": {
        "operation": {
          "$ref": "#/$defs/token"
        },
        "target": {
          "$ref": "#/$defs/token"
        }
      },
      "additionalProperties": false
    },
    "actionAtoms": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/actionAtom"
      }
    },
    "nonEmptyActionAtoms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/actionAtom"
      }
    }
  },
  "additionalProperties": false
}
