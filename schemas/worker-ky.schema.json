{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nazeyatta:schema:worker-ky:0.2",
  "title": "NazeYatta Worker KY Declaration",
  "description": "Bounded pre-work self-report from an acting Worker. It is not Evidence, Authority, or chain-of-thought.",
  "type": "object",
  "required": [
    "schema_version",
    "declaration_id",
    "task_id",
    "classification",
    "intended_action",
    "understood_allowed_scope",
    "understood_forbidden_scope",
    "recognized_hazards",
    "planned_controls",
    "stop_conditions",
    "declared_by",
    "declared_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "declaration_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "classification": {
      "const": "WORKER_SELF_REPORT"
    },
    "intended_action": {
      "$ref": "#/$defs/actionAtom"
    },
    "understood_allowed_scope": {
      "$ref": "#/$defs/nonEmptyActionAtoms"
    },
    "understood_forbidden_scope": {
      "$ref": "#/$defs/actionAtoms"
    },
    "recognized_hazards": {
      "$ref": "#/$defs/kyItems"
    },
    "planned_controls": {
      "$ref": "#/$defs/kyItems"
    },
    "stop_conditions": {
      "$ref": "#/$defs/kyItems"
    },
    "declared_by": {
      "type": "object",
      "required": ["type", "identifier"],
      "properties": {
        "type": {
          "const": "worker"
        },
        "identifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "additionalProperties": false
    },
    "declared_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:/-]{0,127}$"
    },
    "actionAtom": {
      "type": "object",
      "required": ["operation", "target"],
      "properties": {
        "operation": {
          "$ref": "#/$defs/token"
        },
        "target": {
          "$ref": "#/$defs/token"
        }
      },
      "additionalProperties": false
    },
    "actionAtoms": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/actionAtom"
      }
    },
    "nonEmptyActionAtoms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/actionAtom"
      }
    },
    "kyItem": {
      "type": "object",
      "required": ["id", "summary"],
      "properties": {
        "id": {
          "$ref": "#/$defs/token"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "additionalProperties": false
    },
    "kyItems": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/kyItem"
      }
    }
  },
  "additionalProperties": false
}
